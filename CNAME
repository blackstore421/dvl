    <!-- Checkout Modal -->
    <div id="checkout-modal" class="modal-overlay">
        <div class="bg-[#0a0a0a] border border-white/10 p-10 rounded-3xl max-w-md w-full mx-4 shadow-2xl">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-xl font-bold">Checkout</h2>
                <button onclick="closeCheckout()" class="text-gray-500 hover:text-white transition-colors">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="space-y-6">
                <!-- User Profile Summary -->
                <div class="flex items-center gap-4 p-5 bg-white/5 rounded-2xl border border-white/5">
                    <img id="modal-pfp" src="" class="w-14 h-14 rounded-full border-2 border-indigo-500/50" alt="User">
                    <div>
                        <p class="text-sm font-bold" id="modal-username">User#0000</p>
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                            <p class="text-[10px] text-gray-400 uppercase tracking-widest">Account Linked</p>
                        </div>
                    </div>
                </div>

                <!-- Plan Summary -->
                <div class="p-6 bg-white/5 rounded-2xl border border-white/5 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 opacity-10">
