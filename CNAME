    <!-- Feedback Message Box -->
    <div id="msg-box" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-white text-black px-8 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest shadow-2xl transform translate-y-32 transition-all duration-300 z-50">
        Message
    </div>

    <script>
        let selectedPlanData = { name: '', price: 0 };
        let isLoggedIn = false;
        
        // Mock User Data based on selection image
        const mockUser = {
            username: "s.k26",
            pfp: "https://api.dicebear.com/7.x/avataaars/svg?seed=s.k26&backgroundColor=b6e3f4"
        };

        function showMessage(text) {
            const box = document.getElementById('msg-box');
            box.innerText = text;
            box.style.transform = 'translateY(0) translateX(-50%)';
            setTimeout(() => {
                box.style.transform = 'translateY(128px) translateX(-50%)';
            }, 3000);
        }

        function startDiscordAuth() {
            // Show the simulated Discord OAuth screen
            document.getElementById('discord-oauth').style.display = 'flex';
        }

        function cancelLogin() {
            document.getElementById('discord-oauth').style.display = 'none';
            showMessage("Authorization cancelled.");
        }

        function finalizeLogin() {
            // Simulate the "Redirecting" phase
            const authorizeBtn = document.querySelector('.discord-btn-primary');
            authorizeBtn.innerText = "Authorizing...";
            authorizeBtn.disabled = true;

            setTimeout(() => {
                document.getElementById('discord-oauth').style.display = 'none';
                isLoggedIn = true;
                
                // Update UI elements with Profile Data
                document.getElementById('login-btn').classList.add('hidden');
                document.getElementById('profile-card').classList.remove('hidden');
                
                document.getElementById('header-pfp').src = mockUser.pfp;
                document.getElementById('header-username').innerText = mockUser.username;
                
                // Set Modal Data ahead of time
                document.getElementById('modal-pfp').src = mockUser.pfp;
                document.getElementById('modal-username').innerText = mockUser.username;
                
                showMessage(`Logged in as ${mockUser.username}`);
            }, 1000);
        }

        function selectPlan(element, name, price) {
            document.querySelectorAll('.card-gradient').forEach(card => card.classList.remove('card-active'));
            element.classList.add('card-active');

            selectedPlanData = { name, price };

            if (!isLoggedIn) {
                showMessage("Authentication Required");
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            openCheckout();
        }

        function openCheckout() {
            document.getElementById('checkout-plan-name').innerText = selectedPlanData.name;
            document.getElementById('checkout-plan-price').innerText = `$${selectedPlanData.price}.00`;
            document.getElementById('checkout-modal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeCheckout() {
            document.getElementById('checkout-modal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function processPayment(method) {
            showMessage("Generating Payment Session...");
            setTimeout(() => {
                showMessage("Forwarding to PayPal gateway...");
            }, 1000);
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeCheckout();
        });
    </script>
</body>
