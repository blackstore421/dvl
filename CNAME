                    <h3 class="text-xs font-bold tracking-widest text-gray-300 uppercase mb-2">1 Day</h3>
                    <div class="text-4xl font-bold mb-1">$5</div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase tracking-tighter">24 Hours</div>
                </div>

                <div onclick="selectPlan(this, '1 Week', 20)" class="card-gradient rounded-xl p-8 flex flex-col items-center text-center">
                    <div class="icon-box mb-6"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
                    <h3 class="text-xs font-bold tracking-widest text-gray-300 uppercase mb-2">1 Week</h3>
                    <div class="text-4xl font-bold mb-1">$20</div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase tracking-tighter">7 Days</div>
                </div>

                <div onclick="selectPlan(this, '1 Month', 40)" class="card-gradient rounded-xl p-8 flex flex-col items-center text-center relative border-white/20">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2"><span class="popular-badge">MOST POPULAR</span></div>
                    <div class="icon-box mb-6 border-white/20 text-white"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
                    <h3 class="text-xs font-bold tracking-widest text-white uppercase mb-2">1 Month</h3>
                    <div class="text-4xl font-bold mb-1 text-white">$40</div>
                    <div class="text-[10px] text-gray-400 font-bold uppercase tracking-tighter">30 Days</div>
                </div>

                <div onclick="selectPlan(this, 'Lifetime', 150)" class="card-gradient rounded-xl p-8 flex flex-col items-center text-center">
                    <div class="icon-box mb-6 text-gray-400"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
                    <h3 class="text-xs font-bold tracking-widest text-gray-300 uppercase mb-2">Lifetime</h3>
                    <div class="text-4xl font-bold mb-1">$150</div>
