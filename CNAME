            <div class="flex flex-col gap-3">
                <button onclick="finalizeLogin()" class="discord-btn-primary w-full py-3 rounded font-medium text-sm">Authorize</button>
                <button onclick="cancelLogin()" class="discord-btn-secondary w-full py-2 rounded text-sm text-gray-400">Cancel</button>
            </div>
            
            <p class="mt-6 text-[11px] text-gray-500">Redirects to: <span class="text-gray-300">https://69fxap.lol</span></p>
        </div>
    </div>

    <!-- Main View -->
    <div id="main-view" class="flex flex-col items-center py-20 w-full">
        <!-- Header Section -->
        <header class="text-center mb-16 animate-fade">
            <h1 class="hero-title font-extrabold">dvl</h1>
            <p class="server-text font-light">S E R V E R</p>
            <p class="max-w-md mx-auto mt-8 text-gray-400 text-sm leading-relaxed">
                Automated extraction and decryption system. Exclusive access. Fully private environment for advanced data management.
            </p>
                     
                <div id="profile-card" class="hidden mx-auto bg-white/5 border border-white/10 p-4 rounded-2xl flex items-center gap-4 max-w-xs animate-fade">
                    <div class="relative">
                        <img id="header-pfp" src="" class="w-12 h-12 rounded-full pfp-glow" alt="PFP">
                        <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-black rounded-full"></div>
                    </div>
                </div>
